# Backend API base URL (no trailing slash, no /api/v1)
NEXT_PUBLIC_API_URL=http://localhost:4000

# PostHog product analytics. Leave the key empty to turn analytics off (the default).
# The project key is public by design (it ships to the browser); never put a personal
# or "secret" PostHog key here. Use https://eu.i.posthog.com for an EU project.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# This site's public address. Link previews (WhatsApp, etc.) and canonical links on store and
# product pages are built from it; unset, they point at a placeholder domain.
NEXT_PUBLIC_SITE_URL=https://app.kampmax.com

# Where phones get the Kampmax app, for the "Open app" bar on shared product and store pages.
# Leave empty until the app is published. Android falls back to the Play Store page on its own.
NEXT_PUBLIC_ANDROID_APP_URL=
NEXT_PUBLIC_IOS_APP_URL=

# MapTiler public map key (browser-exposed by design).
# Create one at https://cloud.maptiler.com/account/keys/ and restrict it to your
# site's allowed HTTP origins. Never use a private/secret key here.
NEXT_PUBLIC_MAPTILER_API_KEY=your_key_here
